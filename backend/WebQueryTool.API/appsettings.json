{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=webquerytool;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "your-secret-key-must-be-at-least-32-characters-long-for-security",
    "Issuer": "WebQueryTool",
    "Audience": "WebQueryTool-Users",
    "ExpirationMinutes": 60
  },
  "DatabaseSettings": {
    "MaxConnectionsPerPool": 20,
    "MinConnectionsPerPool": 5,
    "QueryTimeoutSeconds": 60,
    "ConnectionTimeoutSeconds": 30,
    "MaxResultSetSize": 10000
  },
  "Security": {
    "EnableQueryEncoding": true,
    "AllowRawSqlQueries": false,
    "EnableAuditLogging": true,
    "MaxQueryLength": 100000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
